      "panels": []
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Độ tươi dữ liệu nguồn (giờ)",
      "description": "Số giờ kể từ lần cập nhật mới nhất ở Sales.SalesOrderHeader. Xanh < 24h, vàng < 48h, đỏ ≥ 48h (khớp ngưỡng source freshness).",
      "datasource": {
        "uid": "adventureworks-mssql"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "adventureworks-mssql"
          },
          "rawSql": "SELECT DATEDIFF(hour, MAX(ModifiedDate), GETDATE()) AS hours_since_last_load\nFROM Sales.SalesOrderHeader",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 24
              },
              {
                "color": "red",
                "value": 48
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Số dòng các bảng silver / gold",
      "description": "",
      "datasource": {
        "uid": "adventureworks-mssql"
      },
      "gridPos": {
        "h": 7,
        "w": 9,
        "x": 6,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "adventureworks-mssql"
          },
          "rawSql": "SELECT s.name AS [Schema], t.name AS [Bảng], SUM(p.rows) AS [Số dòng]\nFROM sys.tables AS t\nINNER JOIN sys.schemas AS s ON t.schema_id = s.schema_id\nINNER JOIN sys.partitions AS p ON t.object_id = p.object_id AND p.index_id IN (0, 1)\nWHERE s.name IN ('${env}_silver', '${env}_gold')\nGROUP BY s.name, t.name\nORDER BY s.name, t.name",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 13,
      "type": "piechart",
      "title": "Phân khúc khách hàng (RFM)",
      "description": "",
      "datasource": {
        "uid": "adventureworks-mssql"
      },
      "gridPos": {
        "h": 7,
        "w": 9,
        "x": 15,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "adventureworks-mssql"
          },
          "rawSql": "SELECT customer_segment AS segment, COUNT(*) AS customers\nFROM [${env}_gold].[gld_customer_segments]\nGROUP BY customer_segment",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
