          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        }
      }
    },
    {
      "id": 14,
      "type": "barchart",
      "title": "Doanh thu theo tháng",
      "description": "",
      "datasource": {
        "uid": "adventureworks-mssql"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "adventureworks-mssql"
          },
          "rawSql": "SELECT FORMAT(order_date, 'yyyy-MM') AS [Tháng], SUM(total_revenue) AS [Doanh thu]\nFROM [${env}_gold].[gld_sales_summary]\nGROUP BY FORMAT(order_date, 'yyyy-MM')\nORDER BY 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "showValue": "never",
        "legend": {
          "showLegend": false
        },
        "xTickLabelRotation": -45,
        "xTickLabelSpacing": 100
      }
    }
  ]
